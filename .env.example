# Optional local LaTeX compiler
LATEX_COMPILE_ENABLED=0
# TECTONIC_BIN=
# TECTONIC_CACHE_DIR=
# TECTONIC_ONLY_CACHED=1
# Optional Poppler tool for checking embedded fonts in submission PDFs.
# PDFFONTS_BIN=pdffonts

# Optional remote model. Keep credentials in .env.local.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=

# Enables the loopback-only synthetic fixture and mock model.
RESEARCH_TEST_MODE=0

# Optional local TeX Live for trusted projects. Default project profiles use Tectonic.
# LATEX_SYSTEM_TEX_ENABLED=1
# LATEX_SYSTEM_TEX_WSL=Ubuntu-24.04
# LATEX_LOCAL_CJK_FONT_DIR="/absolute/path/to/authorized/fonts"

# Optional Word-to-TeX conversion on the local workbench.
# WORD_IMPORT_ENABLED=1
# LIBREOFFICE_BIN=soffice
# PANDOC_BIN=pandoc
